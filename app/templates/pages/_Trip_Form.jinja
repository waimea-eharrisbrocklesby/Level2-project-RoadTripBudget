{% extends 'pages/_base.jinja' %}

{% block content %}

<h2>Add Trip</h2>

<form method="POST" action="/add_trip">


<label for="trip_name">Trip Name:</label>
<input type="text" id="trip_name" name="Trip_Name" required>

<br><br>

<label for="trip_budget">Trip Budget:</label>
<input type="number" id="trip_budget" name="Trip_Budget" min="0" required>

<br><br>

<button type="submit">Add Trip</button>


</form>

{% endblock %}
