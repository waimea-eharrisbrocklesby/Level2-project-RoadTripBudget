```jinja
{% extends 'pages/_base.jinja' %}

{% block content %}

<h2>Add Activity</h2>

<form method="POST" action="/add_activity/{{ trip_id }}">

    <label for="name">Trip Name:</label>
    <input type="text" id="name" name="Trip_Name" required>

    <br><br>

    <label for="name">Trip Budget:</label>
    <input type="number" id="name" name="Trip_Budget" required>

    <br><br>

    <button type="submit">Add Activity</button>

</form>

{% endblock %}
```
