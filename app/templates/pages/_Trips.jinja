{% extends 'pages/_base.jinja' %}

{% block content %}

<h2>Road Trips:</h2>

<section id="trips">

    {% for trip in trips %}

        <div class="trip">

            <a href="/trip/{{ trip.id }}" class="view-trip" title="View Trip">
                >
            </a>

            <h3>{{ trip.Trip_Name }}</h3>
            <p>Budget: ${{ trip.Trip_Budget }}</p>

            <form method="POST" action="/delete_trip/{{ trip.id }}">
                <button type="submit">Delete Trip</button>
            </form>

        </div>

    {% else %}

        <p>No Road Trips!</p>

    {% endfor %}

    <center>
        <a href="/add_trip">Add Trip</a>
    </center>

</section

{% endblock %}